{
  "manifest_version": 3,
  "name": "Автобот — презентація з OLX",
  "version": "0.1.0",
  "description": "Робить з оголошення OLX презентацію для клієнта: PDF або сторінка Telegraph.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*.olx.ua/*", "https://api.telegra.ph/*"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "action": {
    "default_title": "Зробити презентацію з цього оголошення",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
